# Legend AI: LM Studio's OpenAI-compatible endpoint
LEGEND_URL=http://quasar:1234/v1
# Optional: model id to use. Leave empty to use whichever model LM Studio has loaded.
LEGEND_MODEL=
# Optional: how long to wait for an analysis, in milliseconds
LEGEND_TIMEOUT_MS=90000

# Optional: daily token allowance (empty = unlimited)
LEGEND_DAILY_TOKENS=
# Optional: where token usage is saved (default: server/data/token-usage.json)
LEGEND_USAGE_FILE=

PORT=3000
FALLBACK_PORT=3001
